{
  "name": "youlai/think",
  "version": "0.1.1",
  "description": "the new thinkphp framework",
  "type": "project",
  "keywords": [
    "framework",
    "thinkphp",
    "ORM"
  ],
  "homepage": "https://www.youlai.tech",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Ray.Hao",
      "email": "youlaitech@163.com"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "topthink/framework": "^8.0",
    "topthink/think-orm": "^3.0|^4.0",
    "topthink/think-filesystem": "^2.0|^3.0",
    "topthink/think-queue": "^3.0",
    "topthink/think-migration": "^3.0",
    "firebase/php-jwt": "^6.11.1",
    "predis/predis": "^2.3",
    "doctrine/annotations": "^2.0",
    "phpoffice/phpspreadsheet": "^3.10",
    "zircote/swagger-php": "^4.10",
    "guzzlehttp/guzzle": "^7.8",
    "aws/aws-sdk-php": "^3.320",
    "topthink/think-worker": "^5.0",
    "gregwar/captcha": "^1.3",
    "topthink/think-view": "^2.0"
  },
  "require-dev": {
    "topthink/think-dumper": "^1.0",
    "topthink/think-trace": "^2.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app",
      "extend\\": "extend"
    }
  },
  "config": {
    "preferred-install": "dist",
    "audit": {
      "block-insecure": false
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover",
      "@php think vendor:publish"
    ],
    "test": "vendor/bin/phpunit",
    "swagger": "php -d error_reporting=0 -d display_errors=0 vendor/bin/openapi config/swagger.php app/auth/controller app/system/controller app/file/controller app/codegen/controller -o public/swagger.json --format json 2>nul"
  }
}
