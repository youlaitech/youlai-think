# ========================================
# 应用配置
# ========================================
APP_DEBUG = true

# ========================================
# 数据库配置
# ========================================
DB_TYPE = mysql
DB_HOST = www.youlai.tech
DB_NAME = youlai_admin
DB_USER = youlai
DB_PASS = 123456
DB_PORT = 3306
DB_CHARSET = utf8mb4

# ========================================
# Redis 配置
# ========================================
REDIS_HOST = www.youlai.tech
REDIS_PORT = 6379
REDIS_PASSWORD = 123456
REDIS_DB = 0
REDIS_PREFIX =

# ========================================
# 安全配置
# ========================================
# 会话模式: jwt | redis-token
SECURITY_SESSION_MODE = jwt
# JWT 密钥 (HS256 算法至少 32 字符)
JWT_SECRET = SecretKey012345678901234567890123456789012345678901234567890123456789
# JWT 签发者
JWT_ISSUER = youlai-think
# 访问令牌有效期 (秒)，默认 2 小时
JWT_ACCESS_TTL = 7200
# 刷新令牌有效期 (秒)，默认 7 天
JWT_REFRESH_TTL = 604800

# ========================================
# 其他配置
# ========================================
DEFAULT_LANG = zh-cn
