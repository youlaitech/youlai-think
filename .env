# 应用配置
APP_DEBUG = false

# 跨域来源白名单（逗号分隔），留空时仅放行本地开发前端
CORS_ALLOWED_ORIGINS = http://localhost:3000,http://localhost:5173

# 数据库配置
DB_TYPE = mysql
DB_HOST = www.youlai.tech
DB_NAME = youlai_admin
DB_USER = youlai
DB_PASS = 123456
DB_PORT = 3306
DB_CHARSET = utf8mb4

# Redis 配置
REDIS_HOST = www.youlai.tech
REDIS_PORT = 6379
REDIS_PASSWORD = 123456
REDIS_DB = 0
REDIS_PREFIX =

# 安全配置
SECURITY_SESSION_MODE = jwt
JWT_SECRET = SecretKey012345678901234567890123456789012345678901234567890123456789
JWT_ISSUER = youlai
JWT_ACCESS_TTL = 7200
JWT_REFRESH_TTL = 604800

# 文件存储（FILE_TYPE: s3 / local / aliyun）
FILE_TYPE = s3

# S3 对象存储（RustFS，S3 协议兼容，默认本地）
S3_ENDPOINT = http://127.0.0.1:9000
S3_ACCESS_KEY = rustfs-admin
S3_SECRET_KEY = rustfs-admin
S3_BUCKET = public
S3_DOMAIN =

# 阿里云 OSS 对象存储
ALIYUN_OSS_ENDPOINT =
ALIYUN_OSS_ACCESS_KEY_ID =
ALIYUN_OSS_ACCESS_KEY_SECRET =
ALIYUN_OSS_BUCKET =
ALIYUN_OSS_DOMAIN =

# 本地存储
LOCAL_PATH =
LOCAL_BASE_URL = /storage
